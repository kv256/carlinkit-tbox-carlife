# Copy to .env (git-ignored) and fill in; read by scripts/deploy.sh and scripts/pull_logs.sh.
# A --serial argument always wins over these.

# Box Wi-Fi ADB addresses (host:port), space-separated, tried in order when no device is connected.
TBOX_ADB_IPS=""

# adb binary, if it is not at ../tools/linux/platform-tools/adb.
# ADB_BIN="/path/to/adb"
